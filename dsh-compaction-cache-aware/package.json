    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SeptTpes/dsh-cache-aware-compaction.git"
  },
